[Unit]
Description=Synora Cognitive Advisory Service
After=synora-bus.service
Requires=synora-bus.service

[Service]
Type=simple

User=synora
Group=synora

Environment=SYNORA_BUS=/run/synora/bus.sock
Environment=SYNORA_COGNITIVE_CAPTURE=false
Environment=SYNORA_COGNITIVE_DRY_RUN=1
EnvironmentFile=-/etc/synora/cognitive.env
ExecStart=/opt/synora/bin/synora-cognitive

Restart=always
RestartSec=2

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

