[Unit]
Description=Synora post-boot OTA health gate
After=synora-bus.service synora-core.service synora-api.service synora-discovery.service synora-actions.service synora-connect.service
Wants=synora-bus.service synora-core.service synora-api.service synora-discovery.service synora-actions.service synora-connect.service
ConditionPathExists=/usr/bin/rauc

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/synora/bin/synora-ota mark-good
NoNewPrivileges=true
TimeoutStartSec=30s
TimeoutStopSec=15s
KillMode=mixed
UMask=0077
TasksMax=128

[Install]
WantedBy=multi-user.target
