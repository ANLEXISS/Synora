[Unit]
Description=Synora Actions Service
After=synora-bus.service
Requires=synora-bus.service

[Service]
Type=simple

User=synora
Group=synora

ExecStart=/opt/synora/bin/synora-actions

Restart=always
RestartSec=2
TimeoutStopSec=15s
KillMode=mixed
UMask=0077

NoNewPrivileges=true

LimitNOFILE=4096
TasksMax=128

[Install]
WantedBy=multi-user.target
