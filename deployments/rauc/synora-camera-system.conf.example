# M046 production template for a camera. Install only after the camera
# hardware qualification; this file is not applied by CI.
[system]
compatible=Synora Camera
bootloader=uboot
boot-attempts=3

[keyring]
path=/etc/rauc/synora/camera-ca-bundle.pem
check-purpose=codesign
check-crl=true

[slot.rootfs.0]
device=/dev/disk/by-partlabel/SYNORA_CAMERA_ROOT_A
type=ext4
bootname=A

[slot.rootfs.1]
device=/dev/disk/by-partlabel/SYNORA_CAMERA_ROOT_B
type=ext4
bootname=B
