{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "synora.cognitive.context-frame/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","provenance","logical_timestamp","episode","temporal","topology","actions","availability"],
  "properties": {
    "schema_version":{"const":"synora.cognitive.context-frame/v1"},
    "provenance":{"enum":["real","replay","simulated_test"]},
    "logical_timestamp":{"type":"string","format":"date-time"},
    "episode":{"type":"object","additionalProperties":false,"required":["phase","age_seconds","segment_count","fact_count","calm_seconds","gap_count","expired","resumed"],"properties":{"phase":{"enum":["initial","candidate","confirmed","final","unknown"]},"age_seconds":{"type":"number","minimum":0,"maximum":31536000},"segment_count":{"type":"integer","minimum":0,"maximum":4096},"fact_count":{"type":"integer","minimum":0,"maximum":65536},"calm_seconds":{"type":"number","minimum":0,"maximum":31536000},"gap_count":{"type":"integer","minimum":0,"maximum":4096},"expired":{"type":"boolean"},"resumed":{"type":"boolean"}}},
    "temporal":{"type":"object","additionalProperties":false,"required":["recurrence","persistence","intensification","short_window","medium_window","long_window","stability","sequence"],"properties":{"recurrence":{"$ref":"#/$defs/pattern"},"persistence":{"$ref":"#/$defs/pattern"},"intensification":{"$ref":"#/$defs/pattern"},"short_window":{"$ref":"#/$defs/pattern"},"medium_window":{"$ref":"#/$defs/pattern"},"long_window":{"$ref":"#/$defs/pattern"},"stability":{"$ref":"#/$defs/pattern"},"sequence":{"type":"array","maxItems":32,"items":{"enum":["presence","motion","access","alarm","pose","camera_health","gap","action","unknown"]}}}},
    "topology":{"type":"object","additionalProperties":false,"required":["visited_zones","transition","direction","coverage","correlation_ambiguous"],"properties":{"visited_zones":{"type":"array","maxItems":32,"uniqueItems":true,"items":{"enum":["public","private","restricted","protected","unknown"]}},"transition":{"enum":["expected","anomalous","unknown"]},"direction":{"enum":["entering","leaving","within","unknown"]},"coverage":{"enum":["complete","partial","unknown"]},"correlation_ambiguous":{"type":"boolean"}}},
    "actions":{"type":"object","additionalProperties":false,"required":["last_action","last_result","cooldown","failure_count","idempotent","pending"],"properties":{"last_action":{"enum":["none","notify","record","announce","unknown"]},"last_result":{"enum":["none","success","failed","blocked","suppressed","unknown"]},"cooldown":{"type":"boolean"},"failure_count":{"type":"integer","minimum":0,"maximum":4096},"idempotent":{"type":"boolean"},"pending":{"type":"boolean"}}},
    "availability":{"type":"object","additionalProperties":false,"required":["camera_coverage","unavailable_modules","degraded_sources","quality"],"properties":{"camera_coverage":{"enum":["complete","partial","unavailable","unknown"]},"unavailable_modules":{"type":"array","maxItems":32,"uniqueItems":true,"items":{"enum":["vision_person","vision_pose","vision_face","vision_vehicle","vision_plate","vision_animal","camera_health","sensors","store","api"]}},"degraded_sources":{"type":"integer","minimum":0,"maximum":64},"quality":{"type":"number","minimum":0,"maximum":1}}}
  },
  "$defs":{"pattern":{"enum":["none","isolated","repeated","persistent","calm","escalating","unknown","unavailable","stable","unstable","insufficient"]}}
}
