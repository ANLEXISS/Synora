{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synora.invalid/schemas/vision-media-suite-manifest-v1.schema.json",
  "title": "Synora Vision V1 external media suite manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "media_root_env", "slots"],
  "properties": {
    "schema_version": {"const": "synora.vision.media-suite-manifest/v1"},
    "version": {"type": "string", "minLength": 1},
    "media_root_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "slots": {
      "type": "array",
      "minItems": 65,
      "items": {"$ref": "#/$defs/slot"}
    }
  },
  "$defs": {
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite", "case_id", "clip_relative_path", "clip_sha256", "condition_tags", "technical_metadata", "module", "expected", "provenance", "license", "asset_status"],
      "properties": {
        "suite": {"enum": ["face_known", "face_unknown", "face_ambiguous", "vehicle_presence", "plate_reading", "animal_presence", "camera_health"]},
        "case_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
        "clip_relative_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*://)[a-zA-Z0-9_./-]+$"},
        "clip_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "condition_tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["indoor", "outdoor", "day", "night", "low_light", "frontal", "profile", "occluded", "distant", "single_subject", "multi_subject", "empty_scene", "stationary", "moving", "clear", "degraded", "resident_known", "identity_unknown", "identity_ambiguous", "vehicle_present", "animal_present", "no_target", "healthy_camera", "stream_missing", "frozen_frame", "tamper_suspected"]}},
        "technical_metadata": {
          "type": "object", "additionalProperties": false,
          "required": ["container", "codec", "width", "height", "frame_count", "duration"],
          "properties": {
            "container": {"type": "string"}, "codec": {"type": "string"},
            "width": {"type": "integer", "minimum": 0}, "height": {"type": "integer", "minimum": 0}, "frame_count": {"type": "integer", "minimum": 0},
            "duration": {"type": "string"}
          }
        },
        "module": {"enum": ["face_recognition", "vehicle_presence", "plate_reading", "animal_presence", "camera_health", "human_pose"]},
        "expected": {
          "type": "object", "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": {"type": "string", "minLength": 1},
            "presence": {"type": "string", "enum": ["present", "absent", "ambiguous"]},
            "confidence_minimum_percent": {"type": "integer", "minimum": 0, "maximum": 100},
            "subject_ref": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"}
          }
        },
        "provenance": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "asset_status": {"enum": ["placeholder", "available", "quarantined"]},
        "not_run_reason": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"asset_status": {"const": "placeholder"}}}, "then": {"required": ["not_run_reason"]}},
        {
          "if": {"properties": {"asset_status": {"const": "available"}}, "required": ["asset_status"]},
          "then": {
            "properties": {
              "technical_metadata": {
                "required": ["container", "codec", "width", "height", "frame_count", "duration"],
                "properties": {
                  "codec": {"minLength": 1, "not": {"const": "pending"}},
                  "width": {"minimum": 1},
                  "height": {"minimum": 1},
                  "frame_count": {"minimum": 1},
                  "duration": {"pattern": "^[0-9]+(\\.[0-9]+)?(ms|s|m)$"}
                }
              }
            }
          }
        }
      ]
    }
  }
}
